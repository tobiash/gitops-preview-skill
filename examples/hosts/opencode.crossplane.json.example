{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gitops-preview-crossplane": {
      "type": "local",
      "command": ["/ABSOLUTE/PATH/TO/gitops-preview", "mcp", "--root", "/ABSOLUTE/PATH/TO/WORKSPACE", "--trusted", "--crossplane", "--crossplane-engine", "/APPROVED/PATH/TO/crossplane-core"],
      "enabled": false
    }
  }
}
